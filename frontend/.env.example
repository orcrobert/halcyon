# Frontend configuration for Vite. Copy to .env.local.

# URL of the Laravel backend API.
VITE_BACKEND_URL=http://localhost:8000

# Optional: bind the dev server to a custom host (e.g. behind a Valet/nginx TLS
# proxy). Leave unset to serve on localhost with default HMR.
# VITE_DEV_HOST=app.halcyon.test
