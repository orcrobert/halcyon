# Frontend configuration for Vite. Copy to .env.local.
# Every value is optional; the defaults work for a standard local setup.

# Where the API lives. Leave unset to call the same origin the app is served
# from, which is what the production build and the dev proxy both do. Only set
# this if you host the frontend separately from the API.
# VITE_API_URL=https://halcyon.example.com

# Where the dev server proxies /api to. Defaults to the API on port 8001.
# VITE_DEV_API_TARGET=http://localhost:8001

# Optional: bind the dev server to a custom host (e.g. behind a Valet/nginx TLS
# proxy). Leave unset to serve on localhost with default HMR.
# VITE_DEV_HOST=app.halcyon.test
