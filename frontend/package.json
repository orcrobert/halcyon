{
  "name": "halcyon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-worklets": "node -e \"require('fs').copyFileSync('node_modules/@soundtouchjs/audio-worklet/dist/soundtouch-processor.js', 'public/soundtouch-processor.js')\"",
    "dev": "npm run copy-worklets && vite",
    "build": "npm run copy-worklets && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^1.0.10",
    "@types/three": "^0.184.1",
    "axios": "^1.20.0",
    "framer-motion": "^12.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
