# Instance configuration. Every value is optional.
# From source: copy to .env at the repo root. In Docker: put the values you need
# in a .env next to compose.yaml. Real environment variables always override
# this file. Every variable is documented in SELF_HOSTING.md#configuration.
#
# Everything under "Decomposer" is only an instance-wide default. Each user can
# override the provider, model, base URL, API key and prompt from their account
# page.

# --- Decomposer: turns a prompt into typed audio elements ---
# gemini | ollama | openai | claude_cli | codex_cli
#   gemini  Google's API. Needs DECOMPOSER_API_KEY.
#   ollama  Any local Ollama server. No key needed.
#   openai  Any OpenAI-compatible /chat/completions endpoint: OpenAI, Groq,
#           OpenRouter, Together, DeepSeek, vLLM, LM Studio, llama.cpp, ...
#   claude_cli  Claude Code on this machine, under its own login. Needs
#               DECOMPOSER_ALLOW_CLI=true.
#   codex_cli   Codex CLI on this machine, under its own login. Needs
#               DECOMPOSER_ALLOW_CLI=true.
DECOMPOSER_PROVIDER=gemini

# Offer the claude_cli and codex_cli providers. Every user of the instance then
# runs on the server's CLI login, so only enable this on a personal instance.
DECOMPOSER_ALLOW_CLI=false

# Docker only: the published image tag compose.yaml runs and the app tracks for
# updates: latest (every release), X.Y (patches of one minor line) or X.Y.Z
# (exact, never moves). Add -cli (latest-cli, X.Y-cli, X.Y.Z-cli) for the image
# with Node, Claude Code and Codex, together with DECOMPOSER_ALLOW_CLI=true.
# Leave blank for latest.
HALCYON_TAG=

# Docker only: the host port, bound to 127.0.0.1. Leave blank for 8001.
HALCYON_PORT=

# Docker only: the image target compose.build.yaml builds from a checkout.
# runtime-cli is the CLI image. Leave blank for the standard image.
HALCYON_TARGET=

# Docker only: set to updates to also run the updater, which lets the admin
# update Halcyon from Account -> Updates. Leave blank to update by hand.
COMPOSE_PROFILES=

# Docker only: instance-wide CLI logins, used when a user has not pasted their
# own on the account page. A Claude Code token comes from `claude setup-token`;
# Codex takes an OpenAI API key. From source these must be real environment
# variables of the API process; the CLIs do not see this file.
CLAUDE_CODE_OAUTH_TOKEN=
CODEX_API_KEY=

# Model id for the chosen provider. Leave blank to use that provider's default
# (gemini-2.5-flash-lite, mistral, gpt-4o-mini, sonnet, or the Codex CLI's own
# configured model respectively). claude_cli takes an alias (sonnet, opus,
# haiku, fable) or a full model id.
DECOMPOSER_MODEL=

# Base URL for the chosen provider. Leave blank to use that provider's default.
#   ollama  http://localhost:11434
#   openai  https://api.openai.com/v1
DECOMPOSER_BASE_URL=

# API key for the chosen provider. Not needed for Ollama or other local servers.
DECOMPOSER_API_KEY=

# --- Generator: the audio-synthesis backend you run yourself ---
# Any HTTP service implementing POST /generate (see SELF_HOSTING.md for the
# contract). Ready-made hosts live in generators/ — local, Colab, Modal,
# Hugging Face.
#
# This is only the fallback. Each user saves their own generators in the account
# page; this value is used by users who have saved none.
# The legacy name COLAB_URL is still accepted.
# Leave it commented in Docker: compose then uses
# http://host.docker.internal:9000, while localhost there is the container.
# GENERATOR_URL=http://localhost:9000

# --- Modal generator (only read by `modal deploy generators/modal/deploy.py`) ---
# These are baked into the Modal image at deploy time. The API ignores them, and
# changing one means redeploying. Shell variables win over this file.

# Any Modal GPU string: T4, L4, A10G, A100, A100-80GB, L40S, H100.
# T4 is the cheapest that fits both models; A10G is roughly twice as fast.
HALCYON_MODAL_GPU=A10G

# Models the generator loads, and seconds of audio per element. These work on
# every host — Colab and the Hugging Face Space read the same names.
AUDIOGEN_MODEL=facebook/audiogen-medium
MUSICGEN_MODEL=facebook/musicgen-large
# Loaded on the first request with a style clip. Blank disables style clips.
STYLE_MODEL=facebook/musicgen-style
GENERATION_DURATION=10

# Seconds an idle Modal container waits before scaling to zero.
HALCYON_MODAL_SCALEDOWN=300

# Lets users without their own token deploy Modal generators from the account
# page. Each user can also save their own token there instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Storage ---
# SQLite database, generated audio, and the at-rest encryption key live here.
DATA_DIR=data

# Encrypts per-user API keys at rest. Generate with: openssl rand -hex 32
# Leave blank and one is created automatically at DATA_DIR/secret.key.
SECRET_KEY=

# --- Accounts ---
# The first account on the server is its administrator and can create the rest.
# Set to false to close signups; the very first account can always register.
ALLOW_REGISTRATION=true

# --- Serving ---
# Built frontend to serve at the root. Leave as-is unless you build elsewhere.
FRONTEND_DIST=frontend/dist

# Only needed if you run the Vite dev server against a remote API, which is the
# one case that crosses origins. Leave blank otherwise; the dev server proxies
# /api and production is served same-origin, so neither needs CORS.
FRONTEND_ORIGIN=
