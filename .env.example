# AI service configuration. Copy to .env and fill in.
# Environment variables always override values in this file.

# --- Decomposer: turns a prompt into typed audio elements ---
# gemini (default) | llama | mistral
DECOMPOSER_MODEL=gemini
# Required when DECOMPOSER_MODEL=gemini
GEMINI_API_KEY=

# Offline fallback, used when DECOMPOSER_MODEL=llama or mistral
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
LLAMA_MODEL=llama3.1:8b

# --- Generator: the audio-synthesis backend you run yourself ---
# Any HTTP service implementing POST /generate (see SELF_HOSTING.md for the
# contract). The bundled Colab notebook is one reference implementation.
# The legacy name COLAB_URL is still accepted.
GENERATOR_URL=http://localhost:9000

# --- Service wiring ---
# Shared secret with the Laravel backend; must match AI_SERVICE_SECRET there.
AI_SERVICE_SECRET=
# Origin of the Laravel backend, allowed by this service's CORS policy.
BACKEND_ORIGIN=http://localhost:8000

# Directory where generated audio is cached on disk.
OUTPUT_DIR=output
