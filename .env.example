# AI service configuration. Copy to .env and fill in.
# Environment variables always override values in this file.
#
# Everything under "Decomposer" is only an instance-wide default. Each user can
# override the provider, model, base URL, and API key from their account page.

# --- Decomposer: turns a prompt into typed audio elements ---
# gemini | ollama | openai
#   gemini  Google's API. Needs DECOMPOSER_API_KEY.
#   ollama  Any local Ollama server. No key needed.
#   openai  Any OpenAI-compatible /chat/completions endpoint: OpenAI, Groq,
#           OpenRouter, Together, DeepSeek, vLLM, LM Studio, llama.cpp, ...
DECOMPOSER_PROVIDER=gemini

# Model id for the chosen provider. Leave blank to use that provider's default
# (gemini-2.5-flash-lite, mistral, or gpt-4o-mini respectively).
DECOMPOSER_MODEL=

# Base URL for the chosen provider. Leave blank to use that provider's default.
#   ollama  http://localhost:11434
#   openai  https://api.openai.com/v1
DECOMPOSER_BASE_URL=

# API key for the chosen provider. Not needed for Ollama or other local servers.
DECOMPOSER_API_KEY=

# --- Generator: the audio-synthesis backend you run yourself ---
# Any HTTP service implementing POST /generate (see SELF_HOSTING.md for the
# contract). The bundled Colab notebook is one reference implementation.
# The legacy name COLAB_URL is still accepted.
GENERATOR_URL=http://localhost:9000

# --- Storage ---
# SQLite database, generated audio, and the at-rest encryption key live here.
DATA_DIR=data

# Encrypts per-user API keys at rest. Generate with: openssl rand -hex 32
# Leave blank and one is created automatically at DATA_DIR/secret.key.
SECRET_KEY=

# --- Accounts ---
# Set to false once your users have signed up to close the instance.
ALLOW_REGISTRATION=true

# --- Service wiring ---
# Origin of the frontend dev server, allowed by this service's CORS policy.
# In production the frontend is served same-origin and this is unused.
FRONTEND_ORIGIN=http://localhost:5173

# Legacy: only needed while the Laravel backend is still in the loop.
AI_SERVICE_SECRET=
BACKEND_ORIGIN=http://localhost:8000
OUTPUT_DIR=output
